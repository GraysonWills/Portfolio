<?xml version="1.0" encoding="UTF-8"?>
<!--
  CloudFront serves /sitemap.xml straight from the S3 origin, so this file can
  never list blog posts: posts publish on their own schedule with no site
  rebuild to regenerate it. It is therefore a sitemap index pointing at the
  generated sitemap, which enumerates every published post from live data.
-->
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <sitemap>
    <loc>https://www.grayson-wills.com/api/discovery/sitemap.xml</loc>
  </sitemap>
</sitemapindex>
